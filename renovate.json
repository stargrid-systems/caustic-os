{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Rust crate minor and patch updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust crates (minor/patch)"
    },
    {
      "description": "Group Rust crate major updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "groupName": "Rust crates (major)"
    },
    {
      "description": "Group Nix flake updates",
      "matchManagers": ["nix"],
      "groupName": "Nix flakes"
    }
  ]
}
